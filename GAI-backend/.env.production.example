PORT=10000
NODE_ENV=production
MONGODB_URI=mongodb+srv://<DB_USER>:<DB_PASSWORD>@<CLUSTER_HOST>/<DATABASE_NAME>?retryWrites=true&w=majority
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_FOR_PRODUCTION
JWT_EXPIRATION_MS=86400000
CLIENT_ORIGIN=https://<YOUR_FIREBASE_PROJECT>.web.app,https://<YOUR_FIREBASE_PROJECT>.firebaseapp.com
CLIENT_URL=https://<YOUR_FIREBASE_PROJECT>.web.app